@implements IAsyncDisposable
@inject IJSRuntime JavaScript

<div @ref="_element" class="schedule-cards" data-editing="@(Session.Editing && Review ? "true" : "false")">
    @for (int roundIndex = 0; roundIndex < Session.Rounds.Length; roundIndex++)
    {
        int index = roundIndex;
        Round round = Session.Rounds[index];
        <section class="round-card card" data-round="@index" aria-label="@($"Round {index + 1}")">
            <header class="round-header">
                <h2>Round @(index + 1)</h2>
                @if (!Review)
                {
                    <span class="round-status">@(round.Complete ? "Complete" : round.InPlay ? "In play" : null)</span>
                    <button class="round-action" aria-label="@($"Round {index + 1} actions")" disabled="@round.Complete" @onclick="() => OnRoundAction.InvokeAsync(index)">⋮</button>
                }
                @if (Review && !Session.Editing && !round.Complete && !round.Games.Any(game => game.Complete))
                {
                    <button class="drag-handle" data-handle="round" aria-label="@($"Move round {index + 1}")" @onkeydown="args => MoveKeyAsync(args, index, -1)">||</button>
                }
            </header>
            @for (int gameIndex = 0; gameIndex < round.Games.Length; gameIndex++)
            {
                int position = gameIndex;
                Game game = round.Games[position];
                <div class="game @(game.RankConflict ? "rank-conflict" : null)" data-game="@position">
                    @if (!Review)
                    {
                        <span class="court @(round.Complete ? "complete" : round.InPlay ? "in-play" : "not-started")" role="img" aria-label="@($"Court {Session.Courts[position]}")"><span style="font-size: @(CourtFontSize(Session.Courts[position]))rem">@Session.Courts[position]</span></span>
                    }
                    <div class="match">
                        <div class="side">
                            @foreach (Guid id in game.Left)
                            {
                                <ScheduleName Session="Session" Id="id" Round="index" Review="Review" Editing="@(Review && Session.Editing)" OnTap="OnTap" OnHold="OnHold" />
                            }
                        </div>
                        <span class="versus">v</span>
                        <div class="side">
                            @foreach (Guid id in game.Right)
                            {
                                <ScheduleName Session="Session" Id="id" Round="index" Review="Review" Editing="@(Review && Session.Editing)" OnTap="OnTap" OnHold="OnHold" />
                            }
                        </div>
                    </div>
                    @if (Review && !Session.Editing && !round.Complete && !game.Complete)
                    {
                        <button class="drag-handle" data-handle="game" aria-label="@($"Move game {position + 1} in round {index + 1}")" @onkeydown="args => MoveKeyAsync(args, index, position)">||</button>
                    }
                </div>
            }
            @if (round.SittingOut.Length > 0)
            {
                <div class="sitting-out">Sitting out:
                    @for (int sittingIndex = 0; sittingIndex < round.SittingOut.Length; sittingIndex++)
                    {
                        Guid id = round.SittingOut[sittingIndex];
                        @if (sittingIndex > 0) { <span>, </span> }
                        <ScheduleName Session="Session" Id="id" Round="index" Review="Review" Editing="@(Review && Session.Editing)" OnTap="OnTap" OnHold="OnHold" />
                    }
                </div>
            }
        </section>
    }
</div>

@code {
    [Parameter, EditorRequired]
    public Session Session { get; set; } = Session.Empty;

    [Parameter]
    public bool Review { get; set; }

    [Parameter]
    public EventCallback<int> OnRoundAction { get; set; }

    [Parameter]
    public EventCallback<Session> OnReorder { get; set; }

    [Parameter]
    public EventCallback<PlayerPosition> OnTap { get; set; }

    [Parameter]
    public EventCallback<PlayerPosition> OnHold { get; set; }

    [JSInvokable]
    public Task HoldAsync(int round, string player) => Session.Editing ? OnHold.InvokeAsync(new(round, Guid.Parse(player))) : Task.CompletedTask;

    private static string CourtFontSize(int court) => Math.Min(2, 4.3 / court.ToString(System.Globalization.CultureInfo.InvariantCulture).Length).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);

    private ElementReference _element;
    private DotNetObjectReference<ScheduleCards>? _reference;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && Review)
        {
            _reference = DotNetObjectReference.Create(this);
            await JavaScript.InvokeVoidAsync("tennisSchedule.attach", _element, _reference);
        }
    }

    [JSInvokable]
    public async Task MoveAsync(int round, int game, int target)
    {
        if (Session.Editing)
        {
            return;
        }

        Session updated = ScheduleOrder.Move(Session, round, game, target);
        if (!ReferenceEquals(updated, Session))
        {
            await OnReorder.InvokeAsync(updated);
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_reference is not null)
        {
            await JavaScript.InvokeVoidAsync("tennisSchedule.detach", _element);
            _reference.Dispose();
        }
    }

    private Task MoveKeyAsync(KeyboardEventArgs args, int round, int game)
    {
        int current = game < 0 ? round : game;
        return args.Key switch
        {
            "ArrowUp" => MoveAsync(round, game, current - 1),
            "ArrowDown" => MoveAsync(round, game, current + 1),
            _ => Task.CompletedTask,
        };
    }
}
