@page "/schedule"
@inject IScheduleStorage Storage
@inject IPlayerStorage PlayerStorage
@inject NavigationManager Navigation
@inject IJSRuntime JavaScript

<PageTitle>Social Tennis</PageTitle>
<header><p class="eyebrow">SOCIAL TENNIS</p><h1>@Heading</h1></header>
@if (_error is not null)
{
    <p role="alert">@_error</p>
}
@if (!_loaded)
{
    <p role="status">Loading…</p>
}
else if (_session is null)
{
    <section class="card">
        <p>There is no active schedule.</p>
        <button disabled="@_busy" @onclick="CreateAsync">Create schedule</button>
    </section>
}
else if (_session.Step == ScheduleStep.Courts)
{
    <form class="card" @onsubmit="SaveCourtsAsync" @onsubmit:preventDefault>
        <label for="courts">Select courts</label>
        <input id="courts" placeholder="e.g. 4,5,6" @bind="_courts" aria-describedby="court-hint" disabled="@_busy" />
        <p id="court-hint">Enter the court numbers, separated by commas.</p>
        <button type="submit" disabled="@_busy">Next</button>
    </form>
}
else if (_session.Step == ScheduleStep.Players)
{
    <section class="card">
        @if (_players.Length == 0)
        {
            <p>No players yet. <a href="players">Add players</a> first, then come back.</p>
        }
        <label for="add-players">Add players</label>
        <div class="search-row">
            <input id="add-players" type="search" placeholder="Type a name" value="@_search" @oninput="Search" disabled="@_busy" autocomplete="off" />
            <button @onclick="AddAsync" disabled="@(_busy || _selected is null)">Add</button>
        </div>
        @if (!string.IsNullOrWhiteSpace(_search))
        {
            Player[] suggestions = Suggestions();
            @if (suggestions.Length == 0)
            {
                <p>No matching players.</p>
            }
            <ul class="suggestions">
                @foreach (Player player in suggestions)
                {
                    <li><button disabled="@_busy" aria-pressed="@(_selected?.Id == player.Id)" @onclick="() => _selected = player">@player.FullName</button></li>
                }
            </ul>
        }
        <h2>Playing (@_session.Players.Length)</h2>
        @if (_session.Players.Length == 0)
        {
            <p>Nobody added yet.</p>
        }
        <ul class="playing">
            @foreach (Player player in _session.Players)
            {
                <li><span>@player.FullName</span><button disabled="@_busy" aria-label="@($"Remove {player.FullName}")" @onclick="() => RemoveAsync(player.Id)">Remove</button></li>
            }
        </ul>
        @if (_session.Players.Length < 4)
        {
            <p>Add at least 4 players.</p>
        }
        @if (_busy)
        {
            <p role="status">Matching players…</p>
        }
        <div class="actions">
            <button disabled="@_busy" @onclick="BackAsync">Back</button>
            <button disabled="@(_busy || _session.Players.Length < 4)" @onclick="GenerateAsync">Next</button>
        </div>
    </section>
}
else
{
    @if (!_session.InPlay && !_session.Editing)
    {
        <button class="back-link" disabled="@_busy" @onclick="ReturnToPlayersAsync">‹ Players</button>
    }
    @if (_session.Rounds.Length < 6)
    {
        <p>With @_session.Players.Length players only @_session.Rounds.Length rounds are possible without anyone partnering the same player twice.</p>
    }
    @if (_session.Editing)
    {
        <section class="card" role="status">
            <p>Press and hold a name to pin or swap a player.</p>
            @if (_swap is not null)
            {
                <p>Tap a player in round @(_swap.Round + 1) to swap with @ScheduleEditing.Name(_session, _swap.Player).</p>
                <button @onclick="() => _swap = null">Cancel</button>
            }
            @if (_message is not null) { <p>@_message</p> }
        </section>
    }
    <ScheduleCards Session="_session" Review="true" OnReorder="SaveAsync" OnHold="HoldAsync" OnTap="TapAsync" />
    <div class="actions">
        <button disabled="@_busy" @onclick="ToggleEditAsync">@(_session.Editing ? "Done" : "Edit")</button>
        @if (_session.Editing)
        {
            <button disabled="@_busy" @onclick="RescheduleAsync">@(_busy ? "Re-scheduling…" : "Re-schedule")</button>
        }
        <button disabled="@_busy" @onclick="PlayAsync">Play</button>
    </div>
}

@if (_session is not null)
{
    <dialog @ref="_optionsDialog" aria-labelledby="player-options-title">
        <div class="dialog-content">
            <h2 id="player-options-title">@(_held is null ? "Player" : ScheduleEditing.Name(_session, _held.Player))</h2>
            <p>@OptionsMessage</p>
            @if (_error is not null) { <p role="alert">@_error</p> }
            <div class="actions">
                @if (_held is not null && !ScheduleEditing.Locked(_session, _held))
                {
                    @if (ScheduleEditing.GameAt(_session, _held) is not null)
                    {
                        <button @onclick="PinAsync">@(_session.Rounds[_held.Round].Pinned.Contains(_held.Player) ? "Unpin" : "Pin")</button>
                    }
                    @if (!_session.Rounds[_held.Round].Pinned.Contains(_held.Player))
                    {
                        <button @onclick="BeginSwapAsync">Swap</button>
                    }
                }
                <button @onclick="CloseOptionsAsync">@(_held is not null && ScheduleEditing.Locked(_session, _held) ? "Close" : "Cancel")</button>
            </div>
        </div>
    </dialog>
    <dialog @ref="_conflictDialog" aria-labelledby="conflict-title">
        <div class="dialog-content">
            <h2 id="conflict-title">Already played together</h2>
            @if (_conflict is not null)
            {
                <p>@ScheduleEditing.Name(_session, _conflict.First) and @ScheduleEditing.Name(_session, _conflict.Second) were partners in round @(_conflict.CompletedRound + 1), which is complete, and are partners again in round @(_conflict.Round + 1). Who should move?</p>
                <div class="actions">
                    <button @onclick="() => ResolveAsync(_conflict.First)">Move @ScheduleEditing.Name(_session, _conflict.First)</button>
                    <button @onclick="() => ResolveAsync(_conflict.Second)">Move @ScheduleEditing.Name(_session, _conflict.Second)</button>
                    <button @onclick="AcceptAsync">Keep them together</button>
                    <button @onclick="CloseConflictAsync">Cancel</button>
                </div>
            }
        </div>
    </dialog>
}

@code {
    private ElementReference _optionsDialog;
    private ElementReference _conflictDialog;
    private PlayerPosition? _held;
    private PlayerPosition? _swap;
    private PartnerConflict? _conflict;
    private readonly List<PartnerConflict> _choices = [];
    private readonly List<PlayerPosition> _moves = [];
    private string? _message;
    private Session? _session;
    private Player[] _players = [];
    private bool _loaded;
    private bool _busy;
    private string _courts = string.Empty;
    private string _search = string.Empty;
    private Player? _selected;
    private string? _error;

    private string Heading => _session?.Step switch
    {
        ScheduleStep.Courts => "Courts",
        ScheduleStep.Players => "Players",
        ScheduleStep.Review => "Review schedule",
        _ => "Schedule",
    };

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _session = await Storage.LoadAsync();
            _players = (await PlayerStorage.LoadAsync()).Players;
            _courts = string.Join(',', _session?.Courts ?? []);
            _loaded = true;
        }
        catch (Exception exception) when (exception is JSException or System.Text.Json.JsonException)
        {
            _error = "Couldn't load the schedule or players. Your saved data has not been changed. Reload to try again.";
        }
    }

    private async Task<bool> PersistAsync(Session session)
    {
        try
        {
            await Storage.SaveAsync(session);
            _session = session;
            _error = null;
            return true;
        }
        catch (JSException)
        {
            _error = "Couldn't save the schedule. Please try again.";
            return false;
        }
    }

    private async Task SaveAsync(Session session)
    {
        await PersistAsync(session);
    }

    private async Task CreateAsync()
    {
        await PersistAsync(Session.Empty);
    }

    private async Task SaveCourtsAsync()
    {
        CourtSelection result = CourtRules.Parse(_courts);
        _error = result.Error;
        if (result.Error is null && _session is not null)
        {
            await PersistAsync(_session with { Courts = result.Courts, Step = ScheduleStep.Players, Rounds = [] });
        }
    }

    private void Search(ChangeEventArgs args)
    {
        _search = args.Value?.ToString() ?? string.Empty;
        _selected = null;
    }

    private Player[] Suggestions()
    {
        return [.. PlayerRules.Find(_players.Where(player => _session?.Players.All(added => added.Id != player.Id) == true),
            _search, PlayerSort.FirstNameAscending).Take(8)];
    }

    private async Task AddAsync()
    {
        if (_session is not null && _selected is not null && !_session.Players.Any(player => player.Id == _selected.Id))
        {
            if (await PersistAsync(_session with { Players = [.. _session.Players, _selected], Rounds = [] }))
            {
                _search = string.Empty;
                _selected = null;
            }
        }
    }

    private async Task RemoveAsync(Guid id)
    {
        if (_session is not null)
        {
            await PersistAsync(_session with { Players = [.. _session.Players.Where(player => player.Id != id)], Rounds = [] });
        }
    }

    private async Task BackAsync()
    {
        if (_session is not null)
        {
            await PersistAsync(_session with { Step = ScheduleStep.Courts });
        }
    }

    private async Task ReturnToPlayersAsync()
    {
        if (_session is { InPlay: false })
        {
            _held = null;
            _swap = null;
            _conflict = null;
            await PersistAsync(_session with { Step = ScheduleStep.Players });
        }
    }

    private async Task GenerateAsync()
    {
        if (_session is null || _session.Players.Length < 4 || _busy)
        {
            return;
        }

        _busy = true;
        await Task.Delay(1); // Yield a paint so the progress message appears before WebAssembly computation.
        try
        {
            Round[] rounds = ScheduleEngine.Generate(_session.Players, _session.Courts.Length, Random.Shared.Next());
            await PersistAsync(_session with { Rounds = rounds, Step = ScheduleStep.Review });
        }
        catch (InvalidOperationException exception)
        {
            _error = exception.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task PlayAsync()
    {
        if (_session is not null && await PersistAsync(ScheduleEditing.Finish(_session) with { InPlay = true }))
        {
            Navigation.NavigateTo("play");
        }
    }
    private string OptionsMessage
    {
        get
        {
            if (_session is null || _held is null)
            {
                return string.Empty;
            }

            Round round = _session.Rounds[_held.Round];
            if (round.Complete)
            {
                return $"Round {_held.Round + 1} is complete, so nothing in it can be changed.";
            }

            if (ScheduleEditing.GameAt(_session, _held)?.Complete == true)
            {
                return "This game is complete, so it can't be changed.";
            }

            return round.Pinned.Contains(_held.Player)
                ? "Pinned in this game: re-scheduling won't move them and they can't be swapped."
                : ScheduleEditing.GameAt(_session, _held) is null ? $"Sitting out in round {_held.Round + 1}." : $"Round {_held.Round + 1}.";
        }
    }

    private async Task ToggleEditAsync()
    {
        if (_session is not null)
        {
            await PersistAsync(_session.Editing ? ScheduleEditing.Finish(_session) : _session with { Editing = true });
            _swap = null;
            _message = null;
        }
    }

    private async Task HoldAsync(PlayerPosition position)
    {
        if (_session is not { Editing: true } || _busy)
        {
            return;
        }

        _held = position;
        await InvokeAsync(StateHasChanged);
        await JavaScript.InvokeVoidAsync("tennisDialogs.show", _optionsDialog);
    }

    private async Task CloseOptionsAsync() => await JavaScript.InvokeVoidAsync("tennisDialogs.close", _optionsDialog);

    private async Task PinAsync()
    {
        if (_session is not null && _held is not null)
        {
            if (await PersistAsync(ScheduleEditing.Pin(_session, _held)))
            {
                _message = $"{ScheduleEditing.Name(_session, _held.Player)} {(_session.Rounds[_held.Round].Pinned.Contains(_held.Player) ? "pinned" : "unpinned")}.";
                await CloseOptionsAsync();
            }
        }
    }

    private async Task BeginSwapAsync()
    {
        _swap = _held;
        _message = null;
        await CloseOptionsAsync();
    }

    private async Task TapAsync(PlayerPosition position)
    {
        if (_session is null || _swap is null || _busy)
        {
            return;
        }

        _message = ScheduleEditing.SwapError(_session, _swap, position);
        if (_message is null && await PersistAsync(ScheduleEditing.Swap(_session, _swap, position)))
        {
            _message = $"Swapped {ScheduleEditing.Name(_session, _swap.Player)} and {ScheduleEditing.Name(_session, position.Player)}.";
            _swap = null;
        }
    }

    private async Task RescheduleAsync()
    {
        if (_session is null || _busy)
        {
            return;
        }

        _swap = null;
        _choices.Clear();
        _moves.Clear();
        await NextConflictAsync();
    }

    private async Task NextConflictAsync()
    {
        if (_session is null)
        {
            return;
        }

        _conflict = ScheduleEditing.CompletedConflict(_session, [.. _choices]);
        if (_conflict is not null)
        {
            await InvokeAsync(StateHasChanged);
            await JavaScript.InvokeVoidAsync("tennisDialogs.show", _conflictDialog);
            return;
        }

        await RepairAsync([.. _moves]);
    }

    private async Task CloseConflictAsync() => await JavaScript.InvokeVoidAsync("tennisDialogs.close", _conflictDialog);

    private async Task AcceptAsync()
    {
        if (_session is not null && _conflict is not null && await PersistAsync(ScheduleEditing.Accept(_session, _conflict)))
        {
            await CloseConflictAsync();
            await NextConflictAsync();
        }
    }

    private async Task ResolveAsync(Guid id)
    {
        if (_conflict is not null)
        {
            _choices.Add(_conflict);
            _moves.Add(new(_conflict.Round, id));
            await CloseConflictAsync();
            await NextConflictAsync();
        }
    }

    private async Task RepairAsync(PlayerPosition[] mustMove)
    {
        if (_session is null)
        {
            return;
        }

        _busy = true;
        await Task.Delay(1); // Yield a paint before WebAssembly computation.
        try
        {
            ScheduleRepairResult result = ScheduleEngine.Repair(_session, 0, mustMove);
            if (!result.Succeeded)
            {
                Guid[]? pair = _session.Rounds.SelectMany((round, index) => round.Games.SelectMany(game => new[] { game.Left, game.Right })
                    .Where(side => side.Length == 2 && ScheduleEditing.Repeated(_session, index, side[0]))).FirstOrDefault();
                _message = pair is null ? "Couldn't re-schedule while preserving fixed positions and the schedule rules."
                    : $"Couldn't separate {ScheduleEditing.Name(_session, pair[0])} & {ScheduleEditing.Name(_session, pair[1])}: pinned players are in the way.";
                return;
            }

            Session repaired = result.Session;
            int moved = repaired.Rounds.Select((round, index) => round.Games.SelectMany(game => game.Left.Concat(game.Right)).Concat(round.SittingOut)
                .Zip(_session.Rounds[index].Games.SelectMany(game => game.Left.Concat(game.Right)).Concat(_session.Rounds[index].SittingOut))
                .Count(pair => pair.First != pair.Second)).Sum();
            if (await PersistAsync(repaired))
            {
                _message = moved == 0 ? "Nothing needed changing." : $"Re-scheduled: {moved} players moved (shown in blue).";
            }
        }
        finally
        {
            _busy = false;
        }
    }

}
