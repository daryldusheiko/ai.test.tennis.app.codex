@page "/"
@inject NavigationManager Navigation
@inject IScheduleStorage Storage

<p role="status">@(_error ?? "Loading…")</p>

@code {
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            Session? session = await Storage.LoadAsync();
            Navigation.NavigateTo(session is { InPlay: true } ? "play" : "players", replace: true);
        }
        catch (Exception exception) when (exception is JSException or System.Text.Json.JsonException)
        {
            _error = "Couldn't load the schedule. Reload to try again.";
        }
    }
}
